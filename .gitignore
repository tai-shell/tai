# Editor and OS artifacts
*~
.DS_Store

# Autotools / configure-time outputs
autom4te.cache/
config.cache
config.log
config.status
configure.lineno

# Build artifacts
*.o
*.lo
*.a
*.orig
*.rej
*.dSYM/

# Configure / make outputs
/Makefile
/builtins/Makefile
/doc/Makefile
/examples/loadables/Makefile
/examples/loadables/Makefile.inc
/examples/loadables/Makefile.sample
/examples/loadables/perl/Makefile
/lib/glob/Makefile
/lib/intl/Makefile
/lib/malloc/Makefile
/lib/readline/Makefile
/lib/sh/Makefile
/lib/termcap/Makefile
/lib/tilde/Makefile
/po/Makefile
/po/Makefile.in
/po/POTFILES
/support/Makefile
/support/bash.pc
/support/bashbug.sh
/support/man2html
/buildconf.h
/config.h
/stamp-h
/.build
/.made

# Binaries and helper outputs
/bash
/bashbug
/bashversion
/builtins/builtext.h
/builtins/builtins.c
/builtins/mkbuiltins
/builtins/pipesize.h
/builtins/psize.aux
# Per-builtin C sources generated from .def files by mkbuiltins. The
# only tai-specific one (holo.c) is regenerated on every build, but
# git status would surface it as untracked without an ignore line.
/builtins/holo.c
/lib/sh/mksignames
/lib/sh/mksyntax

# Top-level generated headers and sources
/lsignames.h
/mksignames
/mksyntax
/pathnames.h
/signames.h
/stdckdint.h
/syntax.c
/version.h
# y.tab.c / y.tab.h are bison-generated from parse.y. Tracking
# them in git looks tempting (lets users build without bison) but
# bites: a fresh checkout's mtime ordering can leave y.tab.c
# newer than parse.y, at which point `make' considers it
# up-to-date and skips regeneration. Any parse.y edit then
# silently fails to land in the binary. Untracked + bison
# required for build.
/y.tab.c
/y.tab.h

# Out-of-tree build directories used by Makefile.tai (linux, etc.)
/build-*/

# Embedded-holo build artifacts (CPython static, freeze output, native cache)
/build/

# Python bytecode caches from importing embedded/runtime/tai_runtime/.
# Harmless to ship but pure churn in `git status`.
__pycache__/
*.pyc
