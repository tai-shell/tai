/* ---- screen_* (SikuliX bridge) ------------------------------------- */

$BUILTIN screen_click
$FUNCTION screen_click_builtin
$SHORT_DOC screen_click X Y [MODIFIER...]
Click at screen coordinates, optionally holding modifiers (e.g. cmd).
$END
int screen_click_builtin (WORD_LIST *list) {
  return tai_holo_dispatch_tool ("screen_click", list);
}

$BUILTIN screen_move
$FUNCTION screen_move_builtin
$SHORT_DOC screen_move X Y
Move the cursor to (X, Y). No click, no scroll, no key.
$END
int screen_move_builtin (WORD_LIST *list) {
  return tai_holo_dispatch_tool ("screen_move", list);
}

$BUILTIN screen_type
$FUNCTION screen_type_builtin
$SHORT_DOC screen_type TEXT
Type a literal string into whatever has keyboard focus.
$END
int screen_type_builtin (WORD_LIST *list) {
  return tai_holo_dispatch_tool ("screen_type", list);
}

$BUILTIN screen_key
$FUNCTION screen_key_builtin
$SHORT_DOC screen_key COMBO
Send a key combo. Examples: "cmd+v", "enter", "shift+tab".
$END
int screen_key_builtin (WORD_LIST *list) {
  return tai_holo_dispatch_tool ("screen_key", list);
}

$BUILTIN screen_scroll
$FUNCTION screen_scroll_builtin
$SHORT_DOC screen_scroll X Y [DIRECTION] [STEPS]
Move to (X, Y) and emit STEPS mouse-wheel events in DIRECTION.
DIRECTION defaults to "down". STEPS defaults to 3.
$END
int screen_scroll_builtin (WORD_LIST *list) {
  return tai_holo_dispatch_tool ("screen_scroll", list);
}

$BUILTIN screen_shot
$FUNCTION screen_shot_builtin
$SHORT_DOC screen_shot [REGION]
Capture the screen and print a JSON blob containing a base64 PNG.
Optional REGION is a JSON object {x,y,width,height}.
$END
int screen_shot_builtin (WORD_LIST *list) {
  return tai_holo_dispatch_tool ("screen_shot", list);
}

$BUILTIN screen_find_image
$FUNCTION screen_find_image_builtin
$SHORT_DOC screen_find_image NEEDLE [REGION] [SCORE]
